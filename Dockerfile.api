# ADGRID API (NestJS + Prisma) — Railway 等のコンテナホスティング向け
# pnpm ワークスペースのため、ルートからビルドする。
FROM node:22-slim AS base
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH
# Prisma のエンジンが OpenSSL を必要とする
RUN apt-get update -y && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/*
RUN corepack enable
WORKDIR /app

# ---- 依存解決 (キャッシュが効くよう manifest だけ先に入れる) ----
FROM base AS deps
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY packages/shared/package.json packages/shared/
COPY apps/api/package.json apps/api/
RUN pnpm install --frozen-lockfile --filter @adgrid/shared... --filter @adgrid/api...

# ---- ビルド ----
FROM base AS build
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/packages/shared/node_modules ./packages/shared/node_modules
COPY --from=deps /app/apps/api/node_modules ./apps/api/node_modules
COPY . .
RUN pnpm --filter @adgrid/api exec prisma generate
RUN pnpm --filter @adgrid/shared build
RUN pnpm --filter @adgrid/api build

# ---- 実行 ----
FROM base AS runtime
ENV NODE_ENV=production
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/packages ./packages
COPY --from=build /app/apps/api ./apps/api
COPY --from=build /app/package.json ./package.json
COPY --from=build /app/pnpm-workspace.yaml ./pnpm-workspace.yaml
WORKDIR /app/apps/api
# 起動前に (1)マイグレーション適用 (2)アプリ用DBロールの用意・権限付与 を行う。
# ロール準備をマイグレーション後に置くことで、新しいテーブルへのGRANT忘れを防ぐ。
CMD ["sh", "-c", "npx prisma migrate deploy && node scripts/ensure-app-role.js && node dist/main.js"]
