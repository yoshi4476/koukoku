generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// マルチテナント基盤 (要件書 §④)。全業務テーブルに tenant_id。
// RLSポリシーは migrations/xxxx_rls/migration.sql で付与する。
// ============================================================

// 認証テーブル (users / tenant_members) はログイン時にテナント文脈なしで
// 参照する必要があるためRLS対象外。アプリ層 (AuthService) のみが触る。
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  createdAt    DateTime @default(now()) @map("created_at")

  memberships TenantMember[]

  @@map("users")
}

model TenantMember {
  id       String @id @default(cuid())
  userId   String @map("user_id")
  tenantId String @map("tenant_id")
  role     String @default("owner") // owner / admin / operator / viewer

  user   User   @relation(fields: [userId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([userId, tenantId])
  @@map("tenant_members")
}

model Tenant {
  id        String   @id
  name      String
  plan      String   @default("starter")
  status    String   @default("active")
  // 版 (要件書 §②)。agency=自社運用版(全機能) / client=提供先版(自社データ閲覧のみ・承認/自動適用は非表示)
  edition   String   @default("agency")
  // 通知設定等のテナント設定 (slackWebhookUrl など)
  settings  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  members     TenantMember[]
  clients     Client[]
  adAccounts  AdAccount[]
  audits      Audit[]
  reports     Report[]
  copyJobs    CopyJob[]
  csvImports  CsvImport[]
  llmCalls    LlmCall[]
  connections MediaConnection[]
  auditTrail  AuditTrail[]
  alertRules  AlertRule[]
  alertEvents AlertEvent[]
  proposals   Proposal[]
  abTests     AbTest[]
  knowledge   KnowledgeAsset[]
  changeLogs  ChangeLog[]
  dashboards  Dashboard[]
  keywordStats KeywordStat[]
  projects    Project[]

  @@map("tenants")
}

// プロジェクト (目的・施策単位)。1クライアントに複数、複数の媒体アカウントを束ねる。
// クライアントが「掲示・推移・アラート・改善」を1か所で行うためのハブ (F-19)。
model Project {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  clientId  String   @map("client_id")
  name      String
  goal      String   @default("conversion") // conversion / awareness / traffic / store
  status    String   @default("active") // active / paused / ended
  note      String   @default("")
  createdAt DateTime @default(now()) @map("created_at")

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  client     Client      @relation(fields: [clientId], references: [id])
  adAccounts AdAccount[]

  @@index([tenantId, clientId])
  @@map("projects")
}

// カスタムダッシュボード (ロードマップ B-5)。テナントが自作・保存・共有する。
// layout はウィジェット配列 (種別・指標・ディメンジョン・グラフ種・幅) のJSON。
model Dashboard {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  name      String
  layout    Json     @default("[]")
  isDefault Boolean  @default(false) @map("is_default")
  createdBy String?  @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt])
  @@map("dashboards")
}

// 変更履歴 (ロードマップ B-2 / 要件書 F-15)。
// ADGRID経由の変更 (承認実行) と媒体側変更を統合タイムライン化し、実績変動と突合する。
model ChangeLog {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  adAccountId String   @map("ad_account_id")
  changedAt   DateTime @default(now()) @map("changed_at")
  actor       String // adgrid / media_console / api
  actorName   String   @default("") @map("actor_name")
  entity      String // campaign / adgroup / ad / account
  field       String // budget / bid / status
  oldValue    String   @default("") @map("old_value")
  newValue    String   @default("") @map("new_value")
  note        String   @default("")

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  adAccount AdAccount @relation(fields: [adAccountId], references: [id])

  @@index([tenantId, adAccountId, changedAt])
  @@map("change_logs")
}

// 勝ちパターン資産集 (ロードマップ B-1 / 要件書 F-17)。
// tenantId=NULL は匿名化・統計化された共有ナレッジ (オプトインしたテナントのみ集計対象)。
// テナント固有のパターンは tenantId 付きで分離保持し、RLSで他テナントから不可視。
model KnowledgeAsset {
  id             String   @id @default(cuid())
  tenantId       String?  @map("tenant_id") // NULL=共有ナレッジ
  industryCode   String   @map("industry_code")
  objective      String   @default("conversion") // conversion / awareness / traffic
  appealAxis     String   @map("appeal_axis")
  creativeSummary String  @map("creative_summary")
  platform       String   @default("")
  winRate        Float    @default(0) @map("win_rate") // 勝率 (0-1)
  sampleSize     Int      @default(0) @map("sample_size")
  liftPct        Float?   @map("lift_pct")
  sourceAnonymized Boolean @default(true) @map("source_anonymized")
  createdAt      DateTime @default(now()) @map("created_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@index([industryCode, objective])
  @@map("knowledge_assets")
}

// 確信度較正 (ロードマップ A-4)。診断カテゴリ別の採用/見送り実績を集計し、
// 「どのパターンの指摘が実際に採用されたか」から確信度スコアを補正する教師データ。
// テナント横断で集計 (tenantId を持たず、全体傾向を学習)。
model CalibrationStat {
  category  String @id // measurement / budget / structure / bidding / creative / other
  adopted   Int    @default(0)
  dismissed Int    @default(0)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("calibration_stats")
}

// A/Bテスト管理 (ロードマップ B-3)。2アームのCVR差を two-proportion z-test で判定
model AbTest {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  clientId    String   @map("client_id")
  name        String
  hypothesis  String   @default("")
  metric      String   @default("cvr") // cvr / ctr
  status      String   @default("running") // running / concluded
  aLabel      String   @map("a_label")
  aImpr       Int      @default(0) @map("a_impr")
  aClicks     Int      @default(0) @map("a_clicks")
  aConv       Int      @default(0) @map("a_conv")
  bLabel      String   @map("b_label")
  bImpr       Int      @default(0) @map("b_impr")
  bClicks     Int      @default(0) @map("b_clicks")
  bConv       Int      @default(0) @map("b_conv")
  winner      String   @default("") // a / b / none
  createdAt   DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  client Client @relation(fields: [clientId], references: [id])

  @@index([tenantId, createdAt])
  @@map("ab_tests")
}

// AI提案の承認・実行 (F-16)。status遷移: pending → approved/rejected → executed/failed → rolled_back
// 承認なしの実行はサービス層で禁止 (承認済みレコードのみ実行)
model Proposal {
  id              String    @id @default(cuid())
  tenantId        String    @map("tenant_id")
  adAccountId     String    @map("ad_account_id")
  actionType      String    @map("action_type") // adjust_budget / adjust_bid / pause_campaign
  actionPayload   Json      @map("action_payload")
  title           String
  evidence        String    @default("")
  risk            String    @default("")
  confidence      String    @default("mid")
  simulation      String    @default("")
  status          String    @default("pending")
  sourceAuditId   String?   @map("source_audit_id")
  sourceRank      Int?      @map("source_rank")
  createdBy       String?   @map("created_by")
  approvedBy      String?   @map("approved_by")
  approvedAt      DateTime? @map("approved_at")
  executedAt      DateTime? @map("executed_at")
  executionNote   String    @default("") @map("execution_note")
  rollbackPayload Json?     @map("rollback_payload")
  createdAt       DateTime  @default(now()) @map("created_at")

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  adAccount AdAccount @relation(fields: [adAccountId], references: [id])

  @@index([tenantId, status, createdAt])
  @@map("proposals")
}

// 異常検知ルール (F-13)。テナント×メトリクスで1件。初回アクセス時にデフォルトを自動作成
model AlertRule {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  metric    String // budget_pace / cpa_spike / cv_zero / spend_drop
  threshold Float
  enabled   Boolean  @default(true)
  channels  Json     @default("[\"inapp\"]") // inapp / slack
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant       @relation(fields: [tenantId], references: [id])
  events AlertEvent[]

  @@unique([tenantId, metric])
  @@map("alert_rules")
}

model AlertEvent {
  id          String    @id @default(cuid())
  tenantId    String    @map("tenant_id")
  ruleId      String    @map("rule_id")
  adAccountId String    @map("ad_account_id")
  severity    String // bad / warn
  title       String
  body        String
  payload     Json      @default("{}")
  firedAt     DateTime  @default(now()) @map("fired_at")
  notifiedAt  DateTime? @map("notified_at")
  ackedAt     DateTime? @map("acked_at")
  ackedBy     String?   @map("acked_by")

  tenant Tenant    @relation(fields: [tenantId], references: [id])
  rule   AlertRule @relation(fields: [ruleId], references: [id])

  @@index([tenantId, firedAt])
  @@index([tenantId, adAccountId, ruleId, firedAt])
  @@map("alert_events")
}

// 操作証跡 (F-10)。追記専用 — adgrid_app のUPDATE/DELETE権限をマイグレーションで剥奪
model AuditTrail {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  userId    String?  @map("user_id")
  action    String // login / login_failed / signup / audit_run / report_run / copy_run / csv_import
  resource  String   @default("")
  detail    Json     @default("{}")
  ip        String   @default("")
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt])
  @@map("audit_trail")
}

model Client {
  id           String @id @default(cuid())
  tenantId     String @map("tenant_id")
  name         String
  industryCode String @default("other") @map("industry_code")
  status       String @default("active")

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  adAccounts   AdAccount[]
  reports      Report[]
  copyJobs     CopyJob[]
  abTests      AbTest[]
  keywordStats KeywordStat[]
  projects     Project[]

  @@index([tenantId])
  @@map("clients")
}

// キーワード実績スナップショット (キーワード最適化 F-18)。
// 検索広告のキーワード単位で直近28日集計を保持し、増額/減額の推奨と
// CTR/コスト/ROIランキングを算出する。マッチタイプ・入札は媒体同期で更新。
model KeywordStat {
  id              String   @id @default(cuid())
  tenantId        String   @map("tenant_id")
  clientId        String   @map("client_id")
  adAccountId     String   @map("ad_account_id")
  platform        String
  keyword         String
  matchType       String   @default("phrase") @map("match_type") // exact / phrase / broad
  currentBid      Decimal? @map("current_bid") @db.Decimal(10, 2)
  impressions     BigInt   @default(0)
  clicks          BigInt   @default(0)
  cost            Decimal  @default(0) @db.Decimal(14, 2)
  conversions     Decimal  @default(0) @db.Decimal(12, 2)
  conversionValue Decimal  @default(0) @map("conversion_value") @db.Decimal(14, 2)
  qualityScore    Int?     @map("quality_score") // 1-10 (Google品質スコア等)
  windowDays      Int      @default(28) @map("window_days")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  client    Client    @relation(fields: [clientId], references: [id])
  adAccount AdAccount @relation(fields: [adAccountId], references: [id])

  @@index([tenantId, adAccountId])
  @@index([tenantId, clientId])
  @@map("keyword_stats")
}

model AdAccount {
  id                String  @id @default(cuid())
  tenantId          String  @map("tenant_id")
  clientId          String  @map("client_id")
  projectId         String? @map("project_id")
  platform          String
  externalAccountId String  @map("external_account_id")
  name              String
  currency          String  @default("JPY")
  isBillable        Boolean @default(true) @map("is_billable")
  monthlyBudget     Decimal? @map("monthly_budget") @db.Decimal(14, 2)

  tenant     Tenant             @relation(fields: [tenantId], references: [id])
  client     Client             @relation(fields: [clientId], references: [id])
  project    Project?           @relation(fields: [projectId], references: [id])
  facts      FactAdPerformance[]
  audits       Audit[]
  csvImports   CsvImport[]
  proposals    Proposal[]
  changeLogs   ChangeLog[]
  keywordStats KeywordStat[]

  @@index([tenantId, clientId])
  @@map("ad_accounts")
}

model MediaConnection {
  id           String    @id @default(cuid())
  tenantId     String    @map("tenant_id")
  platform     String
  status       String    @default("not_connected") // connected / needs_reauth / error / not_connected
  // mock = デモ接続 (擬似データ同期) / oauth = 実API接続 (Phase 2で媒体認証情報設定後)
  mode         String    @default("mock")
  lastSyncedAt DateTime? @map("last_synced_at")
  lastSyncRows Int       @default(0) @map("last_sync_rows")
  errorMessage String    @default("") @map("error_message")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, platform])
  @@map("media_connections")
}

// 統一実績スキーマ (プロンプトD準拠)。MVPは通常テーブル+複合Index。
// スケール時の月次パーティション化 DDL は docs/partitioning.sql 参照。
model FactAdPerformance {
  date            DateTime @db.Date
  tenantId        String   @map("tenant_id")
  adAccountId     String   @map("ad_account_id")
  platform        String
  campaignId      String   @default("") @map("campaign_id")
  campaignName    String   @default("") @map("campaign_name")
  adgroupId       String   @default("") @map("adgroup_id")
  adId            String   @default("") @map("ad_id")
  impressions     BigInt   @default(0)
  clicks          BigInt   @default(0)
  cost            Decimal  @default(0) @db.Decimal(14, 2)
  conversions     Decimal  @default(0) @db.Decimal(12, 2)
  conversionValue Decimal  @default(0) @map("conversion_value") @db.Decimal(14, 2)
  currency        String   @default("JPY")
  extra           Json     @default("{}")

  adAccount AdAccount @relation(fields: [adAccountId], references: [id])

  @@id([tenantId, adAccountId, date, campaignId, adgroupId, adId])
  @@index([tenantId, date])
  @@map("fact_ad_performance")
}

model CsvImport {
  id             String   @id @default(cuid())
  tenantId       String   @map("tenant_id")
  adAccountId    String   @map("ad_account_id")
  fileName       String   @map("file_name")
  detectedFormat String   @map("detected_format")
  encoding       String
  mapping        Json     @default("{}")
  rowCount       Int      @default(0) @map("row_count")
  insertedRows   Int      @default(0) @map("inserted_rows")
  errorRows      Int      @default(0) @map("error_rows")
  status         String   @default("done")
  createdAt      DateTime @default(now()) @map("created_at")

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  adAccount AdAccount @relation(fields: [adAccountId], references: [id])

  @@index([tenantId])
  @@map("csv_imports")
}

// AI実行結果。result は構造化JSON (packages/shared の zod スキーマ検証済み)
model Audit {
  id              String   @id @default(cuid())
  tenantId        String   @map("tenant_id")
  adAccountId     String   @map("ad_account_id")
  promptVersion   String   @map("prompt_version")
  model           String
  mocked          Boolean  @default(false)
  result          Json
  findingStatuses Json     @default("{}") @map("finding_statuses")
  createdAt       DateTime @default(now()) @map("created_at")

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  adAccount AdAccount @relation(fields: [adAccountId], references: [id])

  @@index([tenantId, adAccountId, createdAt])
  @@map("audits")
}

model Report {
  id            String   @id @default(cuid())
  tenantId      String   @map("tenant_id")
  clientId      String   @map("client_id")
  periodType    String   @map("period_type")
  periodStart   DateTime @map("period_start") @db.Date
  promptVersion String   @map("prompt_version")
  model         String
  mocked        Boolean  @default(false)
  result        Json
  createdAt     DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  client Client @relation(fields: [clientId], references: [id])

  @@index([tenantId, clientId, createdAt])
  @@map("reports")
}

model CopyJob {
  id            String   @id @default(cuid())
  tenantId      String   @map("tenant_id")
  clientId      String   @map("client_id")
  platform      String
  promptVersion String   @map("prompt_version")
  model         String
  mocked        Boolean  @default(false)
  input         Json
  result        Json
  lengthChecks  Json     @default("[]") @map("length_checks")
  createdAt     DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  client Client @relation(fields: [clientId], references: [id])

  @@index([tenantId, clientId, createdAt])
  @@map("copy_jobs")
}

// LLM原価計測 (要件書 F-09)。原価ダッシュボードの元データ
model LlmCall {
  id            String   @id @default(cuid())
  tenantId      String   @map("tenant_id")
  feature       String // audit / report / copy / format_detect
  model         String
  inputTokens   Int      @map("input_tokens")
  outputTokens  Int      @map("output_tokens")
  costJpy       Decimal  @map("cost_jpy") @db.Decimal(10, 2)
  latencyMs     Int      @map("latency_ms")
  promptVersion String   @map("prompt_version")
  createdAt     DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt])
  @@map("llm_calls")
}
