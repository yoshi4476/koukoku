# .env にコピーして使用: cp env.example .env
# (すべて未設定でもローカルデフォルトで起動する)

# --- Database (docker-compose のローカルDB) ---
# マイグレーション用 (管理者ロール)
DATABASE_URL="postgresql://adgrid_admin:adgrid_local_dev@localhost:55433/adgrid?schema=public"
# アプリ実行用 (RLS が有効な非特権ロール。マイグレーションが作成する)
APP_DATABASE_URL="postgresql://adgrid_app:adgrid_app_local@localhost:55433/adgrid?schema=public"

# --- Claude API ---
# 未設定の場合、AI機能はモックモードで動作する (開発用)
ANTHROPIC_API_KEY=

# --- API ---
API_PORT=4000
AUTH_SECRET=                          # 本番は必須 (JWT署名。未設定はローカルのみ)

# --- 外部連携 (未設定なら該当機能は無効化・フォールバック) ---
SLACK_SIGNING_SECRET=                 # Slackスラッシュコマンドの署名検証 (B-6)
GOOGLE_ADS_CLIENT_ID=                 # Google広告 実API接続 (Phase 2)
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
STRIPE_SECRET_KEY=                    # 課金 (F-08)
REDIS_URL=redis://localhost:56379     # BullMQ (未接続ならスケジューラ自動無効化)

# --- Web ---
NEXT_PUBLIC_API_BASE=http://localhost:4000
# 開発用: 認証実装までの仮テナント (seed が作成する ID)
DEV_TENANT_ID=t_demo_agency
