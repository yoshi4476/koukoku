# ============================================================
#  ADGRID 環境変数テンプレート
#  使い方:  cp env.example .env   → 値を各自で埋める
#  ※ .env は .gitignore 済み。APIキー等の秘密値は絶対にコミット/共有しない
#  ※ すべて未設定でもローカルデフォルトで起動する（各機能はフォールバック動作）
# ============================================================

# ------------------------------------------------------------
# 【1】データベース（docker-compose のローカルDB。ローカルはこのままでOK）
# ------------------------------------------------------------
# マイグレーション/seed 用（管理者ロール。RLSをバイパスするので実行時には使わない）
DATABASE_URL="postgresql://adgrid_admin:adgrid_local_dev@localhost:55433/adgrid?schema=public"
# アプリ実行用（RLS有効の非特権ロール。本番では必ずこちらで起動＝テナント分離の要）
APP_DATABASE_URL="postgresql://adgrid_app:adgrid_app_local@localhost:55433/adgrid?schema=public"

# ------------------------------------------------------------
# 【2】APIコア（本番で必須のもの）
# ------------------------------------------------------------
AUTH_SECRET=                         # ★本番必須: JWT署名鍵（長いランダム文字列。未設定はローカルのみ）
API_PORT=4000
WEB_ORIGIN=http://localhost:3000     # 本番はフロントの公開URL（CORS＋共有リンク/配信URLの生成に使用）
API_ORIGIN=http://localhost:4000
# NODE_ENV=production                # 本番で設定。RLSロール検証がfail-closed／dev用フラグが無効化される
PLATFORM_ADMIN_EMAILS=               # システム管理画面(/admin)に入れるメール。カンマ区切り。未設定なら誰も入れない

# メール送信（任意）… 未設定でもシステムは動く。設定するとパスワード再設定が自動送信になる
# 未設定の場合は /admin から再設定リンクを発行して手渡す運用になる
RESEND_API_KEY=                      # https://resend.com/api-keys
MAIL_FROM=                           # 例: ADGRID <noreply@yourdomain.co.jp> （送信ドメインの認証が必要）

# ------------------------------------------------------------
# 【3】実AI（Claude） … 未設定なら決定的テンプレートで動作（品質維持）
# ------------------------------------------------------------
ANTHROPIC_API_KEY=                      # 広告文・AI診断・レポート・クリエイティブ生成が実Claude化
                                     # 取得: https://console.anthropic.com/settings/keys

# ------------------------------------------------------------
# 【4】画像生成（Imagen 4） … 未設定なら生成不可（プロンプト提供＋自動バナーで代替）
# ------------------------------------------------------------
GEMINI_API_KEY=                      # どちらか一方でOK。制作物へのAI画像生成が有効化
GOOGLE_API_KEY=                      # 取得: https://aistudio.google.com/apikey
# IMAGEN_ENDPOINT=                   # 任意: 既定エンドポイントを差し替える場合のみ

# ------------------------------------------------------------
# 【5】計測（サーバーサイドCV送信） … 未設定なら計測ヘルスで「未達」表示
#   ※ GA4測定ID / MetaピクセルID は env ではなく画面「クライアント→📡計測」で入力
# ------------------------------------------------------------
META_CAPI_ACCESS_TOKEN=              # Meta Conversions API のアクセストークン（サーバー側CV送信）
                                     # 取得: Meta Events Manager → データソース → Conversions API
GA4_API_SECRET=                      # GA4 Measurement Protocol の API secret（サーバー側CV送信）
                                     # 取得: GA4 管理 → データストリーム → Measurement Protocol API secrets

# ------------------------------------------------------------
# 【6】実配信（Google広告） … 未設定ならデモ接続（決定的サンプルで同期）
# ------------------------------------------------------------
GOOGLE_ADS_DEVELOPER_TOKEN=          # Google広告アカウントへの実接続・実データ同期・実入稿
GOOGLE_ADS_CLIENT_ID=                # 取得: https://ads.google.com/aw/apicenter ＋ Google Cloud OAuth
GOOGLE_ADS_CLIENT_SECRET=

# ------------------------------------------------------------
# 【7】Slack連携 … 未設定なら開発モード（署名検証スキップ）で動作
# ------------------------------------------------------------
SLACK_SIGNING_SECRET=                # スラッシュコマンド /adgrid の署名検証（本番の安全な受付）
SLACK_REPORT_WEBHOOK_URL=            # レポートのSlack配信先（未設定時は共有リンク発行で配信）
                                     # 取得: Slack App → Incoming Webhooks

# ------------------------------------------------------------
# 【8】課金（Stripe） … 未接続なら課金処理はスキップ
# ------------------------------------------------------------
STRIPE_SECRET_KEY=                   # 取得: https://dashboard.stripe.com/apikeys

# ------------------------------------------------------------
# 【9】インフラ（スケジューラ/キュー）
# ------------------------------------------------------------
REDIS_URL=redis://localhost:56379    # BullMQ。未接続ならスケジューラ（週次レポート/異常検知/同期/予算提案）は自動無効
# ENABLE_SCHEDULER=false             # 明示的にスケジューラを止めたい場合のみ

# ------------------------------------------------------------
# 【10】Web
# ------------------------------------------------------------
NEXT_PUBLIC_API_BASE=http://localhost:4000
DEV_TENANT_ID=t_demo_agency          # 開発用の仮テナント（seedが作成。Slackコマンドの既定テナントにも使用）

# ------------------------------------------------------------
# 【11】開発専用フラグ（本番では設定しない＝NODE_ENV=production で無効化）
# ------------------------------------------------------------
# ALLOW_DEV_OWNER=true               # 認証なしowner扱い（ローカル検証用）
# ALLOW_TENANT_HEADER=true           # x-tenant-id ヘッダでのテナント指定（ローカル検証用）
# UPLOAD_DIR=                        # アップロード保存先（既定: <cwd>/uploads）

# ------------------------------------------------------------
#  env ではなく「画面 or DB」で設定するもの（参考）
#  ・GA4測定ID / MetaピクセルID / 拡張CV     → 画面「クライアント → 📡計測」
#  ・予算ペーシングの自動提案(日次)の有効化    → tenant.settings.autoPacingEnabled = true（既定OFF）
# ============================================================
